{
  "name": "autoqa-studio",
  "version": "1.0.0",
  "description": "AI-Powered Autonomous Browser Automation and QA Testing Desktop Application",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.node.json && electron .",
    "dev": "concurrently -k -r \"npm run dev:vite\" \"wait-on tcp:5173 && tsc -p tsconfig.node.json --watch\" \"wait-on tcp:5173 && electron .\"",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.node.json",
    "build": "npm run build:vite && npm run build:electron",
    "package": "npm run build && electron-builder --win",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "keywords": [
    "browser-automation",
    "ai",
    "playwright",
    "qa-testing",
    "electron",
    "gemini"
  ],
  "author": "AutoQA Studio Team",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "playwright-core": "^1.65.1",
    "sql.js": "^1.16.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  }
}
